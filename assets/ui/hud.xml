            <slot id="p4" class="slot" style="[hotbar_slot=4]background:slot_selected;"/>
            <slot id="p5" class="slot" style="[hotbar_slot=5]background:slot_selected;"/>
            <slot id="p6" class="slot" style="[hotbar_slot=6]background:slot_selected;"/>
            <slot id="p7" class="slot" style="[hotbar_slot=7]background:slot_selected;"/>
            <slot id="p8" class="slot" style="[hotbar_slot=8]background:slot_selected;"/>
            <slot id="p9" class="slot" style="[hotbar_slot=9]background:slot_selected;"/>
        </box>
    </box>
</box>
