<box style="position: absolute;inset-bottom: 10;width:100%;align-content: center;flex-direction: column;">
    <box style="align-self: center;flex-direction: column;">
        <box>
            <box style="background: wood.oak.bark;width: 50%;height: 20;align-self: flex-start;margin: 5;">
                <box style="background: rock.limestone;width: health%;"/>
            </box>
            <box style="background: wood.oak.bark;width: 50%;height: 20;align-self: flex-start;margin: 5;">
                <box style="background: rock.limestone;width: stamina%;"/>
