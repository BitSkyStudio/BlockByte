                input: [(slot:0, stack_size_override:1)]
            ),
            front: InventoryAccess(
                input: [(slot:0, stack_size_override:1)]
            ),
            left: InventoryAccess(
                input: [(slot:0, stack_size_override:1)]
            ),
            right: InventoryAccess(
                input: [(slot:0, stack_size_override:1)]
            ),
            up: InventoryAccess(
